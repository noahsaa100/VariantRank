generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Evaluation {
  id                 String    @id @default(uuid())
  createdAt          DateTime  @default(now())
  goal               String
  urls               Json
  anonymousSessionId String?
  processingTime     Int
  variants           Variant[]
}

model Variant {
  id             String     @id @default(uuid())
  evaluationId   String
  url            String
  rank           Int
  totalScore     Float
  categoryScores Json
  rulePenalties  Json
  topDrivers     Json
  features       Json
  evaluation     Evaluation @relation(fields: [evaluationId], references: [id])
}
